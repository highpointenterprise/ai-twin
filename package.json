{
  "name": "voice-agent",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "tsx --test tests/browser/*.test.ts",
    "meet:login": "DOTENV_CONFIG_PATH=server/.env tsx scripts/meet-login.ts",
    "build": "next build",
    "start": "next start",
    "storage:migrate": "DOTENV_CONFIG_PATH=server/.env tsx scripts/migrate-storage.ts",
    "storage:init": "DOTENV_CONFIG_PATH=server/.env tsx scripts/init-object-store.ts",
    "dev:api": "DOTENV_CONFIG_PATH=server/.env tsx watch server/index.ts",
    "build:api": "esbuild server/index.ts server/worker.ts --bundle --platform=node --packages=external --target=node24 --outdir=server/dist",
    "start:api": "DOTENV_CONFIG_PATH=server/.env node server/dist/index.js",
    "test:auth": "tsx --test tests/auth.test.ts",
    "test:auth:browser": "tsx --test tests/browser/auth.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/client-sesv2": "^3.1176.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@radix-ui/react-slot": "^1.5.0",
    "ajv": "^8.20.0",
    "bullmq": "^6.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "esbuild": "^0.28.2",
    "express": "^4.22.3",
    "https-proxy-agent": "^7.0.6",
    "ioredis": "^6.0.0",
    "livekit-client": "^2.23.0",
    "mongodb": "^7.9.0",
    "next": "^15.5.29",
    "next-auth": "^4.24.15",
    "openai": "^6.49.0",
    "playwright": "^1.65.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "twilio": "^5.4.0",
    "undici": "^7.30.2",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.32"
    }
  }
}

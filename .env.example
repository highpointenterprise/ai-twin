# The console works without these values. Live calls require all provider keys.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Public HTTPS origin forwarded to the voice service on port 8080 (no path).
PUBLIC_BASE_URL=
# Supply a private random value of at least 32 characters. Never commit .env.
STREAM_SECRET=
PORT=8080
ADMIN_PORT=8081
MAX_CONCURRENT_CALLS=50
DATA_DIR=.data
# Comma-separated exact hostnames for custom function webhook servers.
FUNCTION_ALLOWED_HOSTS=
# Example credential NAME used by a custom function; provide its value securely.
# TOOL_CRM_TOKEN=

# Self-hosted Google Meet worker. Meetings use the AI keys above, without Twilio.
# Optional: use an installed Chromium instead of Playwright's bundled browser.
CHROMIUM_EXECUTABLE_PATH=
# Optional authorized Google session, created interactively with npm run meet:login.
MEET_GOOGLE_STORAGE_STATE_PATH=
# Set true only in an isolated container where the Chromium sandbox is unavailable.
MEET_CHROMIUM_NO_SANDBOX=false
MAX_CONCURRENT_MEETINGS=2
# HeyGen LiveAvatar LITE access (optional; voice-only meetings do not need it).
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=

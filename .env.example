# Durable storage. Start local dependencies with docker compose up -d --build, then npm run storage:init.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=ai_twin
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=ai-twin
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=ai-twin-artifacts
S3_ACCESS_KEY_ID=local-development
S3_SECRET_ACCESS_KEY=local-development-password
S3_FORCE_PATH_STYLE=true
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Retain this key securely across deploys and restores.
CREDENTIAL_ENCRYPTION_KEY=

# Calling providers (optional until placing calls).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
PUBLIC_BASE_URL=
STREAM_SECRET=
PORT=8080
ADMIN_PORT=8081
MAX_CONCURRENT_CALLS=50
CALLS_PER_MINUTE=60
# Enable only when recording consent and retention requirements are configured.
RECORDING_ENABLED=false
DATA_DIR=.data
FUNCTION_ALLOWED_HOSTS=
HOSTING_MONTHLY_USD=0
HOSTING_EXPECTED_MINUTES_PER_MONTH=10000
HOSTING_EGRESS_USD_PER_GB=0

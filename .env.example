# The console works without these values. Live calls require all provider keys.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Public HTTPS origin forwarded to the voice service on port 8080 (no path).
PUBLIC_BASE_URL=
# Supply a private random value of at least 32 characters. Never commit .env.
STREAM_SECRET=
PORT=8080
ADMIN_PORT=8081
MAX_CONCURRENT_CALLS=50
DATA_DIR=.data
# Comma-separated exact hostnames for custom function webhook servers.
FUNCTION_ALLOWED_HOSTS=
# Example credential NAME used by a custom function; provide its value securely.
# TOOL_CRM_TOKEN=
